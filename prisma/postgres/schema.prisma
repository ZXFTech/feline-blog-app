generator client {
  provider               = "prisma-client"
  output                 = "../../generated/prisma-postgres"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Internal-only model used to verify PostgreSQL CRUD and rollback behavior.
/// It is not a business entity and can be removed after a real PostgreSQL model replaces it.
model PostgresConnectionProbe {
  id        String   @id @default(uuid()) @db.Uuid
  nonce     String   @unique @db.VarChar(64)
  value     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("_app_postgres_connection_probe")
}

model User {
  id              String           @id @default(cuid()) @db.VarChar(191)
  email           String           @unique @db.Citext
  phone           String?          @unique @db.Citext
  username        String           @db.VarChar(191)
  password        String?          @db.VarChar(191)
  authMode        String           @default("legacy") @db.VarChar(10)
  authVersion     Int              @default(0)
  avatar          String?          @db.VarChar(191)
  work            String?          @db.VarChar(191)
  role            Role             @default(USER)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updateAt        DateTime         @updatedAt @db.Timestamptz(3)
  Blog            Blog[]
  Tag             Tag[]
  Todo            Todo[]
  sessions        Session[]
  blogLikes       BlogLike[]
  blogFavorites   BlogFavorite[]
  pomodoroRecords PomodoroRecord[]
  checklists      Checklist[]
  centerIdentity  UserCenterIdentity?
  centerSessions  UserCenterSession[]
  centerFlows     UserCenterFlow[]

  @@map("users")
}

model UserCenterIdentity {
  id              String @id @db.Uuid
  issuer          String
  subject         String
  userId          String @unique @map("user_id") @db.VarChar(191)
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedEmail   String @map("verified_email")
  emailVerifiedAt DateTime @map("email_verified_at") @db.Timestamptz(3)
  boundAt         DateTime @default(now()) @map("bound_at") @db.Timestamptz(3)
  createdFrom     String @map("created_from")
  legacyVerifiedAt DateTime? @map("legacy_verified_at") @db.Timestamptz(3)
  sessions        UserCenterSession[]
  @@unique([issuer, subject])
  @@unique([id, userId])
  @@map("feline_auth_identity")
}

model BrowserAuthState {
  id               String @id @db.Uuid
  browserTokenHash String @unique @map("browser_token_hash")
  epoch            Int @default(0)
  currentFlowId    String? @map("current_flow_id") @db.Uuid
  currentFlow      UserCenterFlow? @relation("CurrentFlow", fields: [currentFlowId, id], references: [id, browserStateId], onDelete: NoAction, onUpdate: NoAction)
  requireFreshAuth Boolean @default(false) @map("require_fresh_auth")
  lastLogoutAt     DateTime? @map("last_logout_at") @db.Timestamptz(3)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  flows            UserCenterFlow[] @relation("BrowserFlows")
  sessions         UserCenterSession[]
  @@index([expiresAt])
  @@map("feline_auth_browser")
}

model UserCenterFlow {
  id                 String @id @db.Uuid
  purpose            String
  stateHash          String @unique @map("state_hash")
  browserStateId     String @map("browser_state_id") @db.Uuid
  browser            BrowserAuthState @relation("BrowserFlows", fields: [browserStateId], references: [id], onDelete: Restrict)
  currentFor         BrowserAuthState[] @relation("CurrentFlow")
  browserEpoch       Int @map("browser_epoch")
  protocolEncrypted  String? @map("protocol_encrypted")
  candidateEncrypted String? @map("candidate_encrypted")
  candidateDigest    String? @map("candidate_digest")
  confirmationRevision Int @default(0) @map("confirmation_revision")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  status             String @default("created")
  legacyUserId       String? @map("legacy_user_id") @db.VarChar(191)
  legacyUser         User? @relation(fields: [legacyUserId], references: [id], onDelete: Restrict)
  legacyAuthVersion  Int? @map("legacy_auth_version")
  legacyVerifiedAt   DateTime? @map("legacy_verified_at") @db.Timestamptz(3)
  requireFreshAuth   Boolean @default(false) @map("require_fresh_auth")
  reauthAfter        DateTime? @map("reauth_after") @db.Timestamptz(3)
  destination        String
  @@unique([id, browserStateId])
  @@index([expiresAt])
  @@map("feline_auth_flow")
}

model UserCenterSession {
  id                   String @id @db.Uuid
  tokenHash            String @unique @map("token_hash")
  userId               String @map("user_id") @db.VarChar(191)
  user                 User @relation(fields: [userId], references: [id], onDelete: Restrict)
  identityId           String @map("identity_id") @db.Uuid
  identity             UserCenterIdentity @relation(fields: [identityId, userId], references: [id, userId], onDelete: Restrict)
  authVersion          Int @map("auth_version")
  browserStateId       String @map("browser_state_id") @db.Uuid
  browser              BrowserAuthState @relation(fields: [browserStateId], references: [id], onDelete: Restrict)
  browserEpoch         Int @map("browser_epoch")
  grantEncrypted       String? @map("grant_encrypted")
  grantKeyId           String? @map("grant_key_id")
  centerSessionId      String @map("center_session_id")
  centerTokenExpiresAt DateTime @map("center_token_expires_at") @db.Timestamptz(3)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@index([browserStateId])
  @@map("feline_auth_session")
}

model AuthRateBucket {
  keyHash     String @map("key_hash")
  operation   String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  @@id([keyHash, operation, windowStart])
  @@index([expiresAt])
  @@map("feline_auth_rate")
}

model Checklist {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.VarChar(191)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createRequestId   String          @db.Uuid
  createPayloadHash String          @db.Char(64)
  name              String          @db.VarChar(100)
  themeColor        String          @db.VarChar(16)
  expiresAt         DateTime        @db.Timestamptz(3)
  revision          Int             @default(1)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?       @db.Timestamptz(3)
  items             ChecklistItem[]

  @@unique([userId, createRequestId])
  @@index([userId])
}

model ChecklistItem {
  id           String    @id @default(uuid()) @db.Uuid
  checklistId  String    @db.Uuid
  checklist    Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  detail       String    @db.Text
  confirmedAt  DateTime? @db.Timestamptz(3)
  createdOrder Int
  revision     Int       @default(1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  @@unique([checklistId, createdOrder])
  @@index([checklistId])
}

model Session {
  id           String   @id @default(cuid()) @db.VarChar(191)
  sessionToken String   @unique @db.VarChar(191)
  userId       String   @db.VarChar(191)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime @db.Timestamptz(3)

  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(191)
  token      String   @unique @db.VarChar(191)
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Blog {
  id            Int            @id @default(autoincrement())
  authorId      String         @db.VarChar(191)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String         @db.VarChar(191)
  content       String         @db.Text
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  delete        Boolean        @default(false)
  tags          TagsOnBlogs[]
  likeCount     Int            @default(0)
  favoriteCount Int            @default(0)
  likes         BlogLike[]
  favorites     BlogFavorite[]
}

model Tag {
  id        Int           @id @default(autoincrement())
  content   String        @db.Citext
  color     String        @db.VarChar(191)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  userId    String        @db.VarChar(191)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos     TagsOnTodos[]
  blogs     TagsOnBlogs[]

  @@unique([userId, content])
}

model Todo {
  id         Int           @id @default(autoincrement())
  content    String        @db.VarChar(500)
  finished   Boolean       @default(false)
  createAt   DateTime      @default(now()) @db.Timestamptz(3)
  updateAt   DateTime      @updatedAt @db.Timestamptz(3)
  finishedAt DateTime      @updatedAt @db.Timestamptz(3)
  delete     Boolean       @default(false)
  userId     String        @db.VarChar(191)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags       TagsOnTodos[]
}

model TagsOnTodos {
  todo       Todo     @relation(fields: [todoId], references: [id])
  todoId     Int
  tag        Tag      @relation(fields: [tagId], references: [id])
  tagId      Int
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  assignedBy String   @db.VarChar(191)

  @@id([todoId, tagId])
}

model TagsOnBlogs {
  blog       Blog     @relation(fields: [blogId], references: [id])
  blogId     Int
  tag        Tag      @relation(fields: [tagId], references: [id])
  tagId      Int
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  assignedBy String   @db.VarChar(191)

  @@id([blogId, tagId])
}

enum Role {
  USER
  ADMIN
  ROOT
  VISITOR
}

model BlogLike {
  id        String   @id @default(cuid()) @db.VarChar(191)
  blogId    Int
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([blogId, userId])
  @@index([userId])
  @@index([blogId])
}

model BlogFavorite {
  id        String   @id @default(cuid()) @db.VarChar(191)
  blogId    Int
  userId    String   @db.VarChar(191)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([blogId, userId])
  @@index([userId])
  @@index([blogId])
}

model DailyStat {
  id          Int           @id @default(autoincrement())
  date        DateTime      @unique @db.Timestamptz(3)
  typingCount Int           @default(0)
  stepCount   Int           @default(0)
  workouts    WorkoutItem[]
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
}

model WorkoutItem {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(191)
  exerciseId  Int
  dailyStatId Int
  dailyStat   DailyStat    @relation(fields: [dailyStatId], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([dailyStatId, exerciseId])
}

model WorkoutSet {
  id            Int         @id @default(autoincrement())
  reps          Int?
  order         Int?
  weight        Float?      @db.DoublePrecision
  duration      Int
  calories      Int         @default(0)
  workoutItemId Int
  workoutItem   WorkoutItem @relation(fields: [workoutItemId], references: [id], onDelete: Cascade)
}

model Exercise {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Citext
}

model Prompt {
  id       Int     @id @default(autoincrement())
  content  String  @db.Text
  platform String  @db.VarChar(191)
  originId String  @db.VarChar(191)
  imageUrl String? @db.VarChar(191)
  marks    String  @db.VarChar(191)
}

enum PomodoroType {
  FOCUS
  SHORT
  LONG
}

enum PomodoroEndReason {
  COMPLETED
  SKIPPED
  STOPPED
}

model PomodoroRecord {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.VarChar(191)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             PomodoroType
  eventId          String?            @db.VarChar(191)
  endReason        PomodoroEndReason?
  finished         Boolean
  summary          String?            @db.Text
  startAt          DateTime           @db.Timestamptz(3)
  endAt            DateTime           @db.Timestamptz(3)
  durationMs       Float              @db.DoublePrecision
  actualDurationMs Float              @db.DoublePrecision
  createAt         DateTime           @default(now()) @db.Timestamptz(3)
  updateAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([userId, eventId])
}
