        "valid": true
      },
      {
        "table": "cleanup_run",
        "name": "cleanup_run_removed_counts_check",
        "definition": "CHECK ((jsonb_typeof(removed_counts) = 'object'::text))",
        "valid": true
      },
      {
        "table": "cleanup_run",
        "name": "cleanup_run_result_code_check",
        "definition": "CHECK ((result_code = ANY (ARRAY['complete'::text, 'pending'::text, 'stalled'::text, 'error'::text])))",
        "valid": true
      },
      {
        "table": "cleanup_state",
        "name": "cleanup_state_check",
        "definition": "CHECK (((cron_job_id IS NULL) = (activated_at IS NULL)))",
        "valid": true
      },
      {
        "table": "cleanup_state",
        "name": "cleanup_state_consecutive_failures_check",
        "definition": "CHECK (((consecutive_failures >= 0) AND (consecutive_failures <= 3)))",
        "valid": true
      },
      {
        "table": "cleanup_state",
        "name": "cleanup_state_history_mode",
        "definition": "CHECK ((history_mode = ANY (ARRAY['disabled'::text, 'managed-proxy-v1'::text, 'isolated-direct-v1'::text])))",
        "valid": true
      },
      {
        "table": "cleanup_state",
        "name": "cleanup_state_history_shape",
        "definition": "CHECK ((((history_mode = 'managed-proxy-v1'::text) AND (cron_job_id IS NOT NULL) AND (history_initial_floor IS NOT NULL) AND (history_initial_floor >= 0) AND (history_prune_floor IS NOT NULL) AND (history_prune_floor >= history_initial_floor) AND (history_prune_cursor IS NOT NULL) AND (history_prune_cursor >= history_prune_floor) AND (((history_prune_upper IS NULL) AND (history_prune_cutoff IS NULL) AND (history_prune_keep_from IS NULL) AND (history_prune_next_expiry IS NULL) AND (history_prune_cursor = history_prune_floor)) OR ((history_prune_upper IS NOT NULL) AND (history_prune_cutoff IS NOT NULL) AND (history_prune_upper >= history_prune_cursor) AND ((history_prune_keep_from IS NULL) OR ((history_prune_keep_from > history_prune_floor) AND (history_prune_keep_from <= history_prune_cursor)))))) OR (((history_mode <> 'managed-proxy-v1'::text) OR (cron_job_id IS NULL)) AND ((history_mode <> 'disabled'::text) OR (cron_job_id IS NULL)) AND (history_initial_floor IS NULL) AND (history_prune_floor IS NULL) AND (history_prune_cursor IS NULL) AND (history_prune_upper IS NULL) AND (history_prune_keep_from IS NULL) AND (history_prune_cutoff IS NULL) AND (history_prune_next_expiry IS NULL) AND (history_next_expiry IS NULL))))",
        "valid": true
      },
      {
        "table": "cleanup_state",
        "name": "cleanup_state_job_name_check",
        "definition": "CHECK ((job_name = 'auth-cleanup'::text))",
        "valid": true
      },
      {
        "table": "cleanup_state",
        "name": "cleanup_state_last_result_check",
        "definition": "CHECK ((last_result = ANY (ARRAY['disabled'::text, 'complete'::text, 'pending'::text, 'stalled'::text, 'error'::text])))",
        "valid": true
      },
      {
        "table": "cleanup_state",
