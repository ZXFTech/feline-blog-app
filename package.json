{
  "name": "feline-blog-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "ts-node": {
    "esm": true
  },
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev --turbopack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm prisma:generate && pnpm db:boundaries && next build",
    "test": "vitest run && pnpm db:boundaries",
    "test:e2e": "playwright test",
    "prisma:generate": "pnpm prisma:generate:legacy && pnpm prisma:generate:postgres",
    "prisma:generate:legacy": "prisma generate --config ./prisma.config.mjs",
    "prisma:generate:postgres": "prisma generate --config ./prisma.postgres.config.ts",
    "prisma:validate": "pnpm prisma:validate:legacy && pnpm prisma:validate:postgres",
    "prisma:validate:legacy": "prisma validate --config ./prisma.config.mjs",
    "prisma:validate:postgres": "prisma validate --config ./prisma.postgres.config.ts",
    "prisma:legacy:dev": "dotenv -e .env.development -- prisma --config ./prisma.config.mjs",
    "prisma:legacy:prod": "dotenv -e .env.production -- prisma --config ./prisma.config.mjs",
    "prisma:legacy:migrate:deploy": "dotenv -e .env.production -- prisma migrate deploy --config ./prisma.config.mjs",
    "prisma:legacy:studio:dev": "dotenv -e .env.development -- prisma studio --config ./prisma.config.mjs",
    "postgres:migrate:dev": "dotenv -e .env.development -- node ./scripts/database/run-postgres-prisma.mjs migrate-dev",
    "postgres:migrate:deploy": "dotenv -e .env.development -- node ./scripts/database/run-postgres-prisma.mjs migrate-deploy",
    "postgres:migrate:status": "dotenv -e .env.development -- node ./scripts/database/run-postgres-prisma.mjs migrate-status",
    "db:check:legacy": "dotenv -e .env.development -- tsx ./scripts/database/check-legacy-connection.ts",
    "db:check:postgres": "dotenv -e .env.development -- tsx ./scripts/database/check-postgres-connection.ts",
    "db:audit:postgres": "dotenv -e .env.development -- tsx ./scripts/database/audit-postgres-connections.ts",
    "db:configure:postgres-roles": "dotenv -e .env.development -- tsx ./scripts/database/configure-postgres-roles.ts",
    "db:verify:postgres-roles": "dotenv -e .env.development -- tsx ./scripts/database/configure-postgres-roles.ts --verify-only",
    "db:smoke:postgres": "dotenv -e .env.development -- tsx ./scripts/database/smoke-postgres.ts",
    "db:migrate:data:dry-run": "dotenv -e .env.development -- tsx ./scripts/database/migrate-legacy-to-postgres.ts --dry-run",
    "db:migrate:data:apply": "dotenv -e .env.development -- tsx ./scripts/database/migrate-legacy-to-postgres.ts --apply",
    "db:migrate:data:verify": "dotenv -e .env.development -- tsx ./scripts/database/migrate-legacy-to-postgres.ts --verify-only",
    "db:boundaries": "node ./scripts/database/check-boundaries.mjs",
    "prisma-migrate-build": "pnpm prisma:legacy:migrate:deploy",
    "prisma-generate:dev": "dotenv -e .env.development -- pnpm prisma:generate:legacy",
    "prisma-generate:prod": "dotenv -e .env.production -- pnpm prisma:generate:legacy",
    "prisma:dev": "pnpm prisma:legacy:dev",
    "prisma:prod": "pnpm prisma:legacy:prod",
    "prisma-studio:dev": "pnpm prisma:legacy:studio:dev",
    "build-local:dev": "dotenv -e .env.development -- pnpm prisma:generate && dotenv -e .env.development -- node --loader ts-node/esm ./bin/build.ts --dev",
    "build-local:prod": "dotenv -e .env.production -- pnpm prisma:generate && dotenv -e .env.production -- node --loader ts-node/esm ./bin/build.ts",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "^7.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "4.4.0",
    "dayjs": "^1.11.19",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "1.16.0",
    "material-symbols": "^0.31.2",
    "next": "16.3.3",
    "next-auth": "^4.24.13",
    "openai": "^6.18.0",
    "pg": "8.16.3",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "7.88.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-virtuoso": "^4.18.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.87.0",
    "shadcn": "4.11.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@alicloud/credentials": "^2.4.3",
    "@alicloud/ecs20140526": "7.0.6",
    "@alicloud/openapi-client": "^0.4.14",
    "@alicloud/tea-console": "^1.0.0",
    "@alicloud/tea-typescript": "^1.7.1",
    "@alicloud/tea-util": "^1.4.9",
    "@playwright/test": "^1.62.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.32",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsx": "4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
