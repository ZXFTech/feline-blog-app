USER_CENTER_RUNTIME_ENVIRONMENT=production
USER_CENTER_TARGET_ENVIRONMENT=production
PRODUCTION_USER_CENTER_CLIENT_SECRET=
PLATFORM_PRODUCTION_SESSION_SECRET=
PLATFORM_PRODUCTION_DATABASE_URL=
PLATFORM_PRODUCTION_POSTGRES_SSL_CA=
PLATFORM_PRODUCTION_POSTGRES_SCHEMA=feline_sdk_prod
POSTGRES_POOL_MAX=5
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=10000
